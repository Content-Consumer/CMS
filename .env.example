# Database (used by both the db service and the app via DATABASE_URL)
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=cms_prod

# App
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Your public hostname (e.g. myapp.exe.dev); use localhost for local testing
PHX_HOST=localhost

# Constructed from the values above — override here if using an external database
DATABASE_URL=ecto://${DB_USER}:${DB_PASSWORD}@db/${DB_NAME}

# Optional tuning
# PORT=4000
# POOL_SIZE=10
# ECTO_IPV6=true
