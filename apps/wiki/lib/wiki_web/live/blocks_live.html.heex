<Layouts.app flash={@flash} breadcrumbs={@breadcrumbs} current_scope={@current_scope}>
<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold">Text Blocks</h1>
    <div :if={!@show_editor && @new_block_type == nil} class="dropdown dropdown-end">
      <button tabindex="0" class="btn btn-primary btn-sm">
        New Block
        <.icon name="hero-chevron-down" class="h-3 w-3 ml-1" />
      </button>
      <ul tabindex="0" class="dropdown-content menu bg-base-100 rounded-box z-10 w-44 p-1 shadow-md border border-base-300 text-sm mt-1">
        <li>
          <button phx-click="show_editor" class="flex items-center gap-2">
            <.icon name="hero-document-text" class="h-4 w-4 shrink-0" />
            Text Block
          </button>
        </li>
        <li>
          <button phx-click="show_webpage_editor" class="flex items-center gap-2">
            <.icon name="hero-globe-alt" class="h-4 w-4 shrink-0" />
            Web Page
          </button>
        </li>
      </ul>
    </div>
  </div>

  <form phx-change="search" phx-submit="search" class="mb-6">
    <input
      type="text"
      name="query"
      value={@search_query}
      placeholder="Search blocks…"
      phx-debounce="300"
      class="input input-bordered w-full"
    />
  </form>

  <%!-- Web Page import editor --%>
  <div :if={@new_block_type == :webpage} class="card bg-base-200 mb-8">
    <div class="card-body">
      <div class="flex items-center justify-between mb-1">
        <h2 class="card-title text-base">Import Web Page</h2>
        <button phx-click="cancel_webpage" class="btn btn-ghost btn-xs">Cancel</button>
      </div>

      <%!-- Step 1: URL input --%>
      <div :if={is_nil(@webpage_draft)}>
        <form phx-submit="fetch_webpage" class="flex gap-2 items-end">
          <div class="form-control flex-1">
            <label class="label pb-1"><span class="label-text text-xs">Article URL</span></label>
            <input
              type="url"
              name="url"
              value={@webpage_url}
              placeholder="https://example.com/article"
              class="input input-bordered input-sm w-full"
              autofocus
              required
              disabled={@webpage_fetching}
            />
          </div>
          <button type="submit" class="btn btn-primary btn-sm" disabled={@webpage_fetching}>
            <span :if={@webpage_fetching} class="loading loading-spinner loading-xs"></span>
            {if @webpage_fetching, do: "Importing…", else: "Import"}
          </button>
        </form>
        <p :if={not @webpage_fetching} class="text-xs opacity-50 mt-2">We'll extract the article text and convert it to markdown.</p>
        <p :if={@webpage_fetching} class="text-xs opacity-50 mt-2">Fetching and extracting article content…</p>
      </div>

      <%!-- Step 2: Edit and save --%>
      <div :if={not is_nil(@webpage_draft)}>
        <form phx-submit="save_webpage_block">
          <input type="hidden" name="url" value={@webpage_draft.url} />
          <div class="form-control mb-3">
            <label class="label pb-1"><span class="label-text text-xs">Title</span></label>
            <input
              type="text"
              name="title"
              value={@webpage_draft.title}
              placeholder="Title"
              class="input input-bordered input-sm w-full"
            />
          </div>
          <div class="form-control mb-3">
            <label class="label pb-1"><span class="label-text text-xs">Content (markdown)</span></label>
            <div id="tiptap-wrapper-webpage" phx-update="ignore">
              <div
                id="tiptap-editor-webpage"
                phx-hook="TiptapEditor"
                data-input-id="block-content-webpage"
                class="tiptap-editor bg-base-100 rounded-box border border-base-300 p-4 min-h-64 cursor-text text-sm"
              >
              </div>
            </div>
            <input type="hidden" name="content" id="block-content-webpage" value={@webpage_draft.content} />
          </div>
          <div class="card-actions justify-end">
            <button type="button" phx-click="cancel_webpage" class="btn btn-ghost btn-sm">Cancel</button>
            <button type="submit" class="btn btn-primary btn-sm">Save Block</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div :if={@show_editor} class="card bg-base-200 mb-8">
    <div class="card-body">
      <h2 class="card-title text-base">New Block</h2>
      <p class="text-xs opacity-60 -mt-2 mb-3">
        Supports markdown — type <kbd class="kbd kbd-xs">**bold**</kbd>,
        <kbd class="kbd kbd-xs"># Heading</kbd>, <kbd class="kbd kbd-xs">- list</kbd> etc.
      </p>
      <form phx-submit="save_block">
        <div id="tiptap-wrapper-new" phx-update="ignore">
          <div
            id="tiptap-editor-new"
            phx-hook="TiptapEditor"
            data-input-id="block-content-new"
            class="tiptap-editor bg-base-100 rounded-box border border-base-300 p-4 min-h-48 cursor-text"
          >
          </div>
        </div>
        <input type="hidden" name="content" id="block-content-new" />
        <div class="card-actions justify-end mt-4">
          <button type="button" phx-click="hide_editor" class="btn btn-ghost btn-sm">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save Block</button>
        </div>
      </form>
    </div>
  </div>

  <div class="space-y-3">
    <.live_component
      :for={block <- @blocks}
      module={WikiWeb.BlockCardLive}
      id={block.id}
      block={block}
      current_scope={@current_scope}
      subblocks={@subblock_map[block.id] || []}
    />

    <div :if={@blocks == []} class="text-center py-16 text-base-content/40">
      No blocks yet. Create one above.
    </div>
  </div>

  <%!-- ArgDown selection popover — single instance outside the :for loop --%>
  <div
    :if={@text_selection != nil}
    id="argdown-popover"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-lg px-4"
  >
    <div class="rounded-box border border-base-300 bg-base-100 shadow-lg p-4 text-sm">
      <div :if={is_nil(@argdown_kind)}>
        <p class="text-xs font-medium opacity-60 mb-3">
          "<span class="italic">{@text_selection.text}</span>"
        </p>
        <div class="flex flex-col gap-3">
          <div>
            <button phx-click="create_highlight" class="btn btn-sm btn-outline">
              Highlight
            </button>
          </div>
          <div class="border-t border-base-200 pt-3">
            <p class="text-xs opacity-40 mb-2">ArgDown</p>
            <div class="flex gap-2">
              <button
                phx-click="argdown_select_kind"
                phx-value-kind="argument"
                class="btn btn-sm btn-outline"
              >
                Add argument
              </button>
              <button
                phx-click="argdown_select_kind"
                phx-value-kind="statement"
                class="btn btn-sm btn-outline"
              >
                Add statement
              </button>
            </div>
          </div>
          <div class="border-t border-base-200 pt-3">
            <button phx-click="argdown_dismiss" class="btn btn-sm btn-ghost">Cancel</button>
          </div>
        </div>
      </div>

      <div :if={not is_nil(@argdown_kind)}>
        <p class="text-xs font-medium opacity-60 mb-3">
          Add as <strong>{@argdown_kind}</strong> to which activity?
        </p>
        <div :if={@argdown_activities == []} class="text-xs opacity-50 mb-2">
          No argument activities yet.
          <.link href="/ext/deliberation/activities/new" class="link">Create one</.link> first.
        </div>
        <div class="flex flex-col gap-1 mb-2">
          <button
            :for={activity <- @argdown_activities}
            phx-click="argdown_create"
            phx-value-activity_id={activity.id}
            class="btn btn-sm btn-outline justify-start"
          >
            {activity.name}
          </button>
        </div>
        <button phx-click="argdown_dismiss" class="btn btn-sm btn-ghost">Cancel</button>
      </div>
    </div>
  </div>
</div>
</Layouts.app>
