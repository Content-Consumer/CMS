<Layouts.flash_group flash={@flash} />

<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold">Text Blocks</h1>
    <button :if={!@show_editor} phx-click="show_editor" class="btn btn-primary btn-sm">
      New Block
    </button>
  </div>

  <form phx-change="search" phx-submit="search" class="mb-6">
    <input
      type="text"
      name="query"
      value={@search_query}
      placeholder="Search blocks…"
      phx-debounce="300"
      class="input input-bordered w-full"
    />
  </form>

  <div :if={@show_editor} class="card bg-base-200 mb-8">
    <div class="card-body">
      <h2 class="card-title text-base">New Block</h2>
      <p class="text-xs opacity-60 -mt-2 mb-3">
        Supports markdown — type <kbd class="kbd kbd-xs">**bold**</kbd>,
        <kbd class="kbd kbd-xs"># Heading</kbd>, <kbd class="kbd kbd-xs">- list</kbd> etc.
      </p>
      <form phx-submit="save_block">
        <div id="tiptap-wrapper-new" phx-update="ignore">
          <div
            id="tiptap-editor-new"
            phx-hook="TiptapEditor"
            data-input-id="block-content-new"
            class="tiptap-editor bg-base-100 rounded-box border border-base-300 p-4 min-h-48 cursor-text"
          >
          </div>
        </div>
        <input type="hidden" name="content" id="block-content-new" />
        <div class="card-actions justify-end mt-4">
          <button type="button" phx-click="hide_editor" class="btn btn-ghost btn-sm">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save Block</button>
        </div>
      </form>
    </div>
  </div>

  <div class="space-y-3">
    <div
      :for={block <- @blocks}
      id={"block-card-#{block.id}"}
      class="card bg-base-100 border border-base-300 shadow-xs"
    >
      <%!-- Edit mode --%>
      <div :if={@editing_block_id == block.id} class="card-body">
        <form phx-submit="update_block">
          <input type="hidden" name="_id" value={block.id} />
          <div id={"tiptap-wrapper-#{block.id}"} phx-update="ignore">
            <div
              id={"tiptap-editor-#{block.id}"}
              phx-hook="TiptapEditor"
              data-input-id={"block-content-#{block.id}"}
              class="tiptap-editor bg-base-50 rounded-box border border-base-300 p-4 min-h-32 cursor-text"
            >
            </div>
          </div>
          <input
            type="hidden"
            name="content"
            id={"block-content-#{block.id}"}
            value={block.block_content.content}
          />
          <div class="card-actions justify-end mt-4">
            <button type="button" phx-click="cancel_edit" class="btn btn-ghost btn-sm">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </div>
        </form>
      </div>
      <%!-- Preview mode --%>
      <div :if={@editing_block_id != block.id} class="card-body py-4 px-5">
        <div class="flex items-center justify-between mb-3">
          <code class="text-xs opacity-40">{block.id}</code>
          <div class="flex items-center gap-1">
            <button
              phx-click="edit_block"
              phx-value-id={block.id}
              class="btn btn-ghost btn-xs"
              title="Edit"
            >
              <.icon name="hero-pencil-square" class="h-4 w-4" />
            </button>
            <button
              phx-click="delete_block"
              phx-value-id={block.id}
              class="btn btn-ghost btn-xs text-error"
              title="Delete"
            >
              <.icon name="hero-trash" class="h-4 w-4" />
            </button>
          </div>
        </div>
        <div class="block-preview text-sm">
          {render_markdown(block.block_content.content)}
        </div>
      </div>
    </div>

    <div :if={@blocks == []} class="text-center py-16 text-base-content/40">
      No blocks yet. Create one above.
    </div>
  </div>
</div>
