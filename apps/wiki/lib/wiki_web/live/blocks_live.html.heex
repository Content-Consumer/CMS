<Layouts.app flash={@flash} breadcrumbs={@breadcrumbs}>
<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold">Text Blocks</h1>
    <button :if={!@show_editor} phx-click="show_editor" class="btn btn-primary btn-sm">
      New Block
    </button>
  </div>

  <form phx-change="search" phx-submit="search" class="mb-6">
    <input
      type="text"
      name="query"
      value={@search_query}
      placeholder="Search blocks…"
      phx-debounce="300"
      class="input input-bordered w-full"
    />
  </form>

  <div :if={@show_editor} class="card bg-base-200 mb-8">
    <div class="card-body">
      <h2 class="card-title text-base">New Block</h2>
      <p class="text-xs opacity-60 -mt-2 mb-3">
        Supports markdown — type <kbd class="kbd kbd-xs">**bold**</kbd>,
        <kbd class="kbd kbd-xs"># Heading</kbd>, <kbd class="kbd kbd-xs">- list</kbd> etc.
      </p>
      <form phx-submit="save_block">
        <div id="tiptap-wrapper-new" phx-update="ignore">
          <div
            id="tiptap-editor-new"
            phx-hook="TiptapEditor"
            data-input-id="block-content-new"
            class="tiptap-editor bg-base-100 rounded-box border border-base-300 p-4 min-h-48 cursor-text"
          >
          </div>
        </div>
        <input type="hidden" name="content" id="block-content-new" />
        <div class="card-actions justify-end mt-4">
          <button type="button" phx-click="hide_editor" class="btn btn-ghost btn-sm">Cancel</button>
          <button type="submit" class="btn btn-primary btn-sm">Save Block</button>
        </div>
      </form>
    </div>
  </div>

  <div class="space-y-3">
    <div
      :for={block <- @blocks}
      id={"block-card-#{block.id}"}
      class="card bg-base-100 border border-base-300 shadow-xs"
    >
      <%!-- Edit mode --%>
      <div :if={@editing_block_id == block.id} class="card-body">
        <form phx-submit="update_block">
          <input type="hidden" name="_id" value={block.id} />
          <div id={"tiptap-wrapper-#{block.id}"} phx-update="ignore">
            <div
              id={"tiptap-editor-#{block.id}"}
              phx-hook="TiptapEditor"
              data-input-id={"block-content-#{block.id}"}
              class="tiptap-editor bg-base-50 rounded-box border border-base-300 p-4 min-h-32 cursor-text"
            >
            </div>
          </div>
          <input
            type="hidden"
            name="content"
            id={"block-content-#{block.id}"}
            value={block.block_content.content}
          />
          <div class="card-actions justify-end mt-4">
            <button type="button" phx-click="cancel_edit" class="btn btn-ghost btn-sm">
              Cancel
            </button>
            <button type="submit" class="btn btn-primary btn-sm">Save</button>
          </div>
        </form>
      </div>
      <%!-- Preview mode --%>
      <div :if={@editing_block_id != block.id} class="card-body py-4 px-5">
        <div class="flex items-center justify-between mb-2">
          <code class="text-xs opacity-40">{block.id}</code>
          <div class="flex items-center gap-1">
            <button
              phx-click="edit_block"
              phx-value-id={block.id}
              class="btn btn-ghost btn-xs"
              title="Edit"
            >
              <.icon name="hero-pencil-square" class="h-4 w-4" />
            </button>
            <button
              phx-click="delete_block"
              phx-value-id={block.id}
              class="btn btn-ghost btn-xs text-error"
              title="Delete"
            >
              <.icon name="hero-trash" class="h-4 w-4" />
            </button>
            <div class="dropdown dropdown-end">
              <button tabindex="0" class="btn btn-ghost btn-xs" title="More options">
                <.icon name="hero-ellipsis-vertical" class="h-4 w-4" />
              </button>
              <ul
                tabindex="0"
                class="dropdown-content menu bg-base-100 rounded-box z-10 w-52 p-1 shadow-md border border-base-300 text-sm"
              >
                <li>
                  <button
                    phx-click="edit_block_title"
                    phx-value-block_id={block.id}
                    class="flex items-center gap-2 w-full"
                  >
                    <.icon name="hero-tag" class="h-4 w-4 shrink-0" />
                    {if @title_map[block.id], do: "Edit title", else: "Set title"}
                  </button>
                </li>
                <li>
                  <button
                    phx-click="show_ref_editor"
                    phx-value-id={block.id}
                    class="flex items-center gap-2 w-full"
                  >
                    <.icon name="hero-link" class="h-4 w-4 shrink-0" />
                    Add reference
                  </button>
                </li>
                <li
                  :for={{ext_name, options} <- Wiki.Block.Extensions.options_for(block)}
                >
                  <details>
                    <summary class="font-medium">{ext_name}</summary>
                    <ul>
                      <li :for={option <- options}>
                        <button
                          phx-click="block_extension_action"
                          phx-value-ext-event={option.event}
                          phx-value-block-id={option.block_id}
                          class="flex items-center gap-2 w-full"
                        >
                          <.icon :if={option.icon} name={option.icon} class="h-4 w-4 shrink-0" />
                          {option.label}
                        </button>
                      </li>
                    </ul>
                  </details>
                </li>
              </ul>
            </div>
          </div>
        </div>
        <%!-- Inline title editor --%>
        <form
          :if={@editing_title_id == block.id}
          phx-submit="save_block_title"
          class="flex gap-2 mb-3"
        >
          <input type="hidden" name="block_id" value={block.id} />
          <input
            type="text"
            name="title"
            value={@title_map[block.id] || ""}
            placeholder="Enter a title…"
            class="input input-sm input-bordered flex-1"
            autofocus
          />
          <button type="submit" class="btn btn-primary btn-sm">Save</button>
          <button type="button" phx-click="cancel_block_title" class="btn btn-ghost btn-sm">
            Cancel
          </button>
        </form>
        <%!-- Title display --%>
        <p
          :if={@title_map[block.id] && @editing_title_id != block.id}
          class="font-semibold text-base mb-1"
        >
          {@title_map[block.id]}
        </p>
        <div
          id={"argdown-#{block.id}"}
          phx-hook="ArgdownSelector"
          data-block-id={block.id}
          data-subblocks={Jason.encode!(@subblock_map[block.id] || [])}
          class="block-preview text-sm"
        >
          {render_markdown(block.block_content.content)}
        </div>
        <%!-- Inline reference editor --%>
        <div :if={@editing_ref_id == block.id} class="mt-3 pt-3 border-t border-base-200">
          <p class="text-xs font-medium opacity-60 mb-2">Search for a block to reference:</p>
          <form phx-change="search_ref" phx-submit="search_ref">
            <input
              type="text"
              name="query"
              value={@ref_search_query}
              placeholder="Type to search…"
              phx-debounce="200"
              class="input input-sm input-bordered w-full"
              autofocus
            />
          </form>
          <ul :if={@ref_suggestions != []} class="mt-2 space-y-1">
            <li :for={suggestion <- @ref_suggestions}>
              <button
                phx-click="create_reference"
                phx-value-target_id={suggestion.id}
                class="w-full text-left text-xs px-3 py-2 rounded-box hover:bg-base-200 truncate"
              >
                <span class="opacity-40 mr-1 font-mono">{String.slice(suggestion.id, 0, 8)}…</span>
                {String.slice(suggestion.block_content.content, 0, 80)}
              </button>
            </li>
          </ul>
          <div :if={@ref_search_query != "" and @ref_suggestions == []} class="mt-2 text-xs opacity-50">
            No blocks found.
          </div>
          <button phx-click="hide_ref_editor" class="btn btn-ghost btn-xs mt-2">Cancel</button>
        </div>
        <%!-- References list --%>
        <div :if={@rel_map[block.id] not in [nil, []]} class="mt-3 pt-3 border-t border-base-200">
          <p class="text-xs font-medium opacity-60 mb-2">References</p>
          <ul class="space-y-1">
            <li :for={rel <- (@rel_map[block.id] || [])} class="flex items-center gap-2 text-xs">
              <.icon name="hero-link" class="h-3 w-3 opacity-40 shrink-0" />
              <span class="opacity-60 font-mono truncate flex-1">
                {other_block_content(rel, block.id)}
              </span>
              <button
                phx-click="delete_relation"
                phx-value-id={rel.id}
                class="btn btn-ghost btn-xs text-error"
                title="Remove"
              >
                <.icon name="hero-x-mark" class="h-3 w-3" />
              </button>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div :if={@blocks == []} class="text-center py-16 text-base-content/40">
      No blocks yet. Create one above.
    </div>
  </div>

  <%!-- ArgDown selection popover — single instance outside the :for loop --%>
  <div
    :if={@text_selection != nil}
    id="argdown-popover"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 w-full max-w-lg px-4"
  >
    <div class="rounded-box border border-base-300 bg-base-100 shadow-lg p-4 text-sm">
      <div :if={is_nil(@argdown_kind)}>
        <p class="text-xs font-medium opacity-60 mb-3">
          "<span class="italic">{@text_selection.text}</span>"
        </p>
        <div class="flex flex-col gap-3">
          <div>
            <button phx-click="create_highlight" class="btn btn-sm btn-outline">
              Highlight
            </button>
          </div>
          <div class="border-t border-base-200 pt-3">
            <p class="text-xs opacity-40 mb-2">ArgDown</p>
            <div class="flex gap-2">
              <button
                phx-click="argdown_select_kind"
                phx-value-kind="argument"
                class="btn btn-sm btn-outline"
              >
                Add argument
              </button>
              <button
                phx-click="argdown_select_kind"
                phx-value-kind="statement"
                class="btn btn-sm btn-outline"
              >
                Add statement
              </button>
            </div>
          </div>
          <div class="border-t border-base-200 pt-3">
            <button phx-click="argdown_dismiss" class="btn btn-sm btn-ghost">Cancel</button>
          </div>
        </div>
      </div>

      <div :if={not is_nil(@argdown_kind)}>
        <p class="text-xs font-medium opacity-60 mb-3">
          Add as <strong>{@argdown_kind}</strong> to which activity?
        </p>
        <div :if={@argdown_activities == []} class="text-xs opacity-50 mb-2">
          No argument activities yet.
          <.link href="/ext/deliberation/activities/new" class="link">Create one</.link> first.
        </div>
        <div class="flex flex-col gap-1 mb-2">
          <button
            :for={activity <- @argdown_activities}
            phx-click="argdown_create"
            phx-value-activity_id={activity.id}
            class="btn btn-sm btn-outline justify-start"
          >
            {activity.name}
          </button>
        </div>
        <button phx-click="argdown_dismiss" class="btn btn-sm btn-ghost">Cancel</button>
      </div>
    </div>
  </div>
</div>
</Layouts.app>
